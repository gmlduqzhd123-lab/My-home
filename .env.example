# 순천집 ZIP 환경변수 예시
# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 git 에 올라가지 않습니다(.gitignore).
# GitHub 에 배포할 때는 저장소 Settings → Secrets and variables → Actions 에 같은 이름으로 등록합니다.

# ── 데이터 수집용 (Python 수집기 · GitHub Actions 에서만 사용. 브라우저 코드에 들어가지 않음) ──

# [필수] 공공데이터포털(data.go.kr) 일반 인증키.
#  '국토교통부_아파트 매매 실거래가 상세 자료' 활용신청 후 마이페이지에서 확인.
#  Encoding 키·Decoding 키 어느 쪽을 넣어도 됩니다.
MOLIT_API_KEY=

# [선택] K-apt 공동주택 단지 목록·기본정보용 키. 비우면 MOLIT_API_KEY 를 사용합니다
#  (같은 계정에서 '국토교통부_공동주택 단지 목록제공 서비스', '공동주택 기본 정보제공 서비스'를 활용신청했다면 키가 같습니다).
KAPT_API_KEY=

# [선택] 청약홈 분양정보용 키. 비우면 MOLIT_API_KEY 를 사용합니다
#  ('한국부동산원_청약홈 분양정보 조회 서비스' 활용신청 필요).
APPLYHOME_API_KEY=

# [선택] Kakao REST API 키 — 단지 지번 주소를 좌표로 바꾸는 데 씁니다. 없으면 지도에 마커가 표시되지 않습니다.
#  Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키. 절대 공개 저장소·브라우저 코드에 넣지 마세요.
KAKAO_REST_API_KEY=

# [선택] 조회할 법정동 시군구코드(쉼표 구분). 기본값 12150,46150
#  12150 = 전남광주통합특별시 순천시(2026-07-01 신설), 46150 = 전라남도 순천시(폐지 코드, 이전 계약분 대비)
# SUNCHEON_LAWD_CODES=12150,46150

# ── 웹앱 빌드용 ──

# [선택] Kakao 지도 JavaScript 키 — 브라우저에 공개되는 키입니다.
#  반드시 Kakao Developers → 앱 → 플랫폼(Web) 에 서비스 도메인(예: https://<계정>.github.io)을 등록해 제한하세요.
#  GitHub Secrets 에는 KAKAO_MAP_APP_KEY 라는 이름으로 등록하면 빌드 때 이 변수로 전달됩니다.
VITE_KAKAO_MAP_APP_KEY=

# [선택] 배포 기준 경로. 비우면 GitHub Actions 에서는 /<저장소이름>/ 이, 로컬에서는 상대경로(./)가 쓰입니다.
# VITE_BASE=/suncheon-zip/
